PORT=3001
# Origens do front que podem chamar a API (separadas por vírgula)
WEB_ORIGINS=http://localhost:5173
DB_PATH=lobby.db
# Valores do `livekit-server --dev` (docker-compose.yml). Troque em produção.
LIVEKIT_URL=ws://localhost:7880
# Endereço do LiveKit visto pela API; padrão: LIVEKIT_URL com http no lugar de ws
# LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
