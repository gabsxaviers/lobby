PORT=3001
# Origens do front que podem chamar a API (separadas por vírgula)
WEB_ORIGINS=http://localhost:5173
# Postgres do docker-compose (porta 5433 no host); em produção, a URL do Neon
DATABASE_URL=postgres://lobby:lobby@localhost:5433/lobby
# Valores do `livekit-server --dev` (docker-compose.yml). Troque em produção.
LIVEKIT_URL=ws://localhost:7880
# Endereço do LiveKit visto pela API; padrão: LIVEKIT_URL com http no lugar de ws
# LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
